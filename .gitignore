# This is the .gitignore file to be placed at the root of your Unity project directory.

# --- Unity Generated Folders and Files ---
# Cache, temporary, and user settings folders generated by Unity
/[Ll]ibrary/
/[Tt]emp/
/[Oo]bj/
/[Bb]uild/
/[Bb]uilds/
/[Ll]ogs/
/[Uu]ser[Ss]ettings/

# Asset Store Tools folder (if used)
[Aa]ssets/AssetStoreTools*

# Memory and performance capture data
[Mm]emoryCaptures/
[Rr]ecordings/

# Files generated during the build process
*.aab
*.app
*.apk

# Ignore imported asset packages (if you don't want to version them)
# *.unitypackage

# --- IDE and External Tools Files (Visual Studio Community Included) ---

# Visual Studio Cache Folder (at the root of the solution/project)
.vs/

# Visual Studio/MonoDevelop files
[Ee]xported[Oo]bj/
*.csproj
*.unityproj
*.sln             # The main solution file, often ignored if teams prefer to generate it on demand
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb

# macOS temporary files
.DS_Store

# --- Advanced Unity Features (Optional Exclusions) ---

# Addressables (if used)
# Ignore generated catalog and hash files
/[Aa]ssets/[Aa]ddressable[Aa]ssets[Dd]ata/*/*.bin*
/[Aa]ssets/[Aa]ddressable[Aa]ssets[Dd]ata/link.xml*
/[Aa]ssets/[Aa]ddressables_Temp*

# Visual Scripting (if used)
# Generated files for Visual Scripting
/[Aa]ssets/Unity.VisualScripting.Generated/

# --- Crucial Note ---
# *.meta files MUST be versioned (unless the corresponding asset is also ignored).
# They are essential for linking assets to scene data. Do NOT uncomment this line:
# *.meta
/PokemonHomeMade/Library/Artifacts
/PokemonHomeMade/Library
/PokemonHomeMade/Logs
/PokemonHomeMade/Temp
*.meta
/PokemonHomeMade2D/Library
/PokemonHomeMade2D/UserSettings
/PokemonHomeMade2D/Temp
